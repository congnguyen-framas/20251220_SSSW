<Window
    x:Class="SSSW.UI.WPF.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SSSW.UI.WPF.ViewModels"
    Title="IT – Shotweight Station"
    Width="1920"
    Height="1080"
    AllowsTransparency="False"
    Background="#F0F2F5"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--  Merge style dictionary  -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ═══════════════════════════════ HEADER (app chrome + nav + per-view info)  ═══════════════════════════════
            Toàn bộ thông tin của view đang active (WindowTitle/RFID/Employee/action buttons) được
            gộp thẳng vào hàng header duy nhất này, bind qua ActiveContent.DataContext.* để tự động
            phản ánh đúng ViewModel của tab đang active (ShotWeightViewModel hay ShotWeightFGViewModel) —
            không cần interface chung, WPF binding engine tự re-evaluate khi ActiveContent đổi.
        -->
        <Border
            Grid.Row="0"
            Background="#0D1117"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="1"
                    Height="40"
                    Margin="5,0,10,0"
                    VerticalAlignment="Center"
                    Source="/SSSW;component/Resources/framas_mini_white.png" />

                <!--
                    Dòng đầu tiên: "{Location} – Scan and Scale Shot Weight (SSSW) – Ver-{version}" —
                    không còn phần "Shotweight Station For Step Component/FG" vì 2 nút tab bên cạnh
                    đã tự thể hiện đang ở màn Step hay FG rồi, không cần lặp lại trong tiêu đề.
                    Bind thẳng vào MainViewModel.WindowTitle (tính 1 lần, không phụ thuộc tab) —
                    KHÔNG bind qua ActiveContent.DataContext.WindowTitle nữa: mỗi ViewModel
                    Step/FG tự tính giá trị này bất đồng bộ với tốc độ khác nhau, khiến dòng tiêu
                    đề "nhảy" giữa 2 giá trị khác nhau khi đổi tab — vi phạm yêu cầu header phải
                    tuyệt đối không đổi khi chuyển Step/FG.
                -->
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="White"
                    Text="{Binding WindowTitle}" />

                <!--  NAV TABS  -->
                <StackPanel Visibility="Hidden"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <RadioButton
                        Command="{Binding SelectStepCommand}"
                        Content="Step Component"
                        GroupName="MainNav"
                        IsChecked="{Binding IsStepActive, Mode=OneWay}"
                        Style="{StaticResource NavTabBtn}" />
                    <RadioButton
                        Command="{Binding SelectFgCommand}"
                        Content="Finished Goods"
                        GroupName="MainNav"
                        IsChecked="{Binding IsFgActive, Mode=OneWay}"
                        Style="{StaticResource NavTabBtn}" />
                </StackPanel>

                <!--
                    RFID / EMPLOYEE.
                    RFID dùng chung cho cả 2 tab (thẻ quét ở tab nào cũng là cùng 1 operator) nên
                    bind thẳng vào MainViewModel.OperatorSession.* (OperatorSessionService) —
                    KHÔNG qua ActiveContent.DataContext nữa: trước đây mỗi tab tự giữ 1 bản RFID
                    riêng nên chuyển tab làm mất thông tin đã quét (trông như bị xóa dù không ai
                    bấm Cancel) — xem OperatorSessionService.cs để biết chi tiết.
                -->
                <StackPanel
                    Grid.Column="4"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        Fill="{Binding OperatorSession.RfidStatus, Converter={StaticResource DriverStatusToColor}}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource LabelStyle}"
                        Text="RFID - Employee ID:" />
                    <!--
                        Bấm vào label số thẻ + tên nhân viên → mở dialog nhập tay RFID
                        (frmRfidInput) khi không quét được thẻ.
                        Background="Transparent" (thay vì null/mặc định) là bắt buộc: TextBlock
                        không có Background thì WPF chỉ hit-test đúng vùng glyph chữ, KHÔNG
                        hit-test phần bounding box còn trống — khi UserName rỗng (chưa scan
                        RFID lần nào) thì TextBlock không có glyph nào cả, nên toàn bộ vùng này
                        "trong suốt" với chuột và click lọt xuống Border phía sau (kích hoạt
                        kéo-thả cửa sổ thay vì mở dialog). MinWidth đảm bảo luôn có vùng bấm
                        được kể cả khi text rỗng.
                    -->
                    <TextBlock
                        Name="_tbEmployee"
                        MinWidth="24"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        Cursor="Hand"
                        Foreground="White"
                        MouseLeftButtonDown="_tbEmployee_MouseLeftButtonDown"
                        Style="{StaticResource LabelStyle}"
                        Text="{Binding OperatorSession.UserName}" />
                </StackPanel>

                <!--
                    ACTION ICON BUTTONS.
                    Reload/History đọc/ mở lại dữ liệu của CHÍNH tab đang active (Step hoặc FG
                    tự có ReloadCommand/HistoryViewCommand riêng) nên vẫn bind qua
                    ActiveContent.DataContext.* — mỗi tab thao tác đúng bảng dữ liệu của nó.
                    Hydra/Settings/Update là hành động cấp APP (đồng bộ Hydra vào FT601 dùng
                    chung cho cả Step lẫn FG, mở màn hình Settings dùng chung, check update
                    toàn app) — trước đây chỉ tồn tại trên ShotWeightViewModel nên bind qua
                    ActiveContent.DataContext.HydraCommand/... resolve ra NULL khi đang ở tab FG
                    (ShotWeightFGViewModel không có 3 property này) → bấm không có tác dụng gì
                    ("khoá" nút trên tab FG). Chuyển hẳn 3 command này lên MainViewModel, bind
                    thẳng {Binding XxxCommand} (không qua ActiveContent) để cả 2 tab đều bấm
                    được như nhau.
                -->
                <StackPanel
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ActiveContent.DataContext.ReloadCommand}"
                        Content="&#xE72C;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Reload" />
                    <Button
                        Command="{Binding ActiveContent.DataContext.HistoryViewCommand}"
                        Content="&#xE81C;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="History" />
                    <Button
                        Command="{Binding HydraCommand}"
                        Content="&#xE895;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Hydra" />
                    <Button
                        Command="{Binding SettingsCommand}"
                        Content="&#xE713;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Settings" />
                    <Button
                        Command="{Binding UpdateCommand}"
                        Content="&#xE777;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Update" />
                </StackPanel>

                <!--  WINDOW CONTROLS  -->
                <StackPanel
                    Grid.Column="6"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Click="btnMinimize_Click"
                        Content="&#xE921;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Minimize" />
                    <Button
                        Click="btnMaximize_Click"
                        Content="&#xE922;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Maximize" />
                    <Button
                        Background="#C62828"
                        Click="btnClose_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ═══════════════════════════════ BODY ═══════════════════════════════  -->
        <ContentControl Grid.Row="1" Content="{Binding ActiveContent}" />
    </Grid>
</Window>
