<UserControl
    x:Class="SSSW.UI.WPF.ShotWeightFGWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SSSW.UI.WPF.ViewModels"
    Background="#F0F2F5"
    mc:Ignorable="d">

    <!--  Merge style dictionary  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  ═══════════════════════════════ MAIN CONTENT ════════════════════════════  -->
        <!--  Title bar (logo/WindowTitle/RFID/icon buttons) đã chuyển lên Main.xaml —
              Main bind trực tiếp vào ActiveContent.DataContext.* để hiển thị đúng
              context của tab đang active (xem Main.xaml). ────────────────────────  -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!--  ────────────────── LEFT PANEL – FG INFORMATION ──────────────────  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="#0D1117"
                            CornerRadius="4,4,0,0">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="FG INFORMATION" />
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <!--  Form content  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  FG Desc  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  FG Code  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Machine + Sample Num  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Size  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Lookup  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Barcode  -->

                                    <!--  ✅ Remark chiếm phần còn lại  -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  FG Description  -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="FG Description" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        MaxLines="3"
                                        MinLines="2"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding FgName}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  FG Code  -->
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="FG Code" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding FgCode}" />
                                </StackPanel>

                                <!--  Machine + Sample Num  -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Machine" />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Machine}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sample Num" />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding SampleNum}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Size  -->
                                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Size" />
                                    <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Size}" />
                                </StackPanel>

                                <!--  Lookup  -->
                                <StackPanel Grid.Row="4">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Select FG" />
                                    <!--  DevExpress LookUpEdit: ItemsSource từ ViewModel, event bridge ở code-behind  -->
                                    <dxg:LookUpEdit
                                        x:Name="cbFgCode"
                                        Margin="0,0,0,8"
                                        AutoPopulateColumns="False"
                                        DisplayMember="FGName"
                                        EditValueChanged="cbFgCode_EditValueChangedAsync"
                                        FontSize="15"
                                        ItemsSource="{Binding FgCodeMaster}"
                                        PopupHeight="500"
                                        PopupWidth="1500"
                                        TextWrapping="Wrap"
                                        ValueMember="FGCode">
                                        <!--
                                            KHÔNG dùng AutoComplete + KHÔNG dùng LookUpEditStyleSettings.AllowColumnFiltering:
                                            popup ở đây đã bị thay hoàn toàn bởi PART_GridControl tùy biến bên dưới, nên 2 setting
                                            đó không áp dụng (chỉ có tác dụng với popup mặc định do AutoPopulateColumns sinh ra) —
                                            để AutoComplete bật cùng lúc với bộ lọc riêng của GridControl gây ra tình trạng đơ khi
                                            gõ tìm và popup không tự đóng sau khi chọn dòng.
                                        -->
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <!--
                                                    ShowSearchPanelMode="Always" của DevExpress không hiển thị khi GridControl nằm trong
                                                    PopupContentTemplate của LookUpEdit (hạn chế đã ghi nhận trên hỗ trợ của DevExpress
                                                    với kiểu popup tùy biến này) — nên tự dựng 1 ô tìm kiếm chung ở hàng trên cùng, bind
                                                    thẳng vào TableView.SearchString (DependencyProperty thật, không qua UI mặc định) để
                                                    có hiệu quả tương đương, kết hợp SearchPanelParseMode="And" bên dưới.
                                                -->
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Padding="6,4"
                                                        Background="#F5F5F5"
                                                        BorderBrush="#DDDDDD"
                                                        BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="Tìm tất cả cột (nhiều từ, cách nhau bằng khoảng trắng):" />
                                                            <TextBox
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="{Binding ElementName=PART_GridControl, Path=View.SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                    </Border>

                                                    <dxg:GridControl
                                                        Name="PART_GridControl"
                                                        Grid.Row="1"
                                                        IsFilterEnabled="True">
                                                    <!--  AutoFilterCondition="Contains" trên từng cột: ô lọc tìm theo "chứa" thay vì mặc định "bắt đầu bằng"  -->
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn
                                                            AutoFilterCondition="Contains"
                                                            ColumnFilterMode="DisplayText"
                                                            FieldName="Machine"
                                                            Header="Machine" />
                                                        <dxg:GridColumn
                                                            AutoFilterCondition="Contains"
                                                            FieldName="Size"
                                                            Header="Size" />
                                                        <dxg:GridColumn
                                                            AutoFilterCondition="Contains"
                                                            FieldName="FGCode"
                                                            Header="FG Code" />
                                                        <dxg:GridColumn
                                                            AutoFilterCondition="Contains"
                                                            FieldName="FGName"
                                                            Header="FG Name" />
                                                        <dxg:GridColumn
                                                            AutoFilterCondition="Contains"
                                                            FieldName="HydraOrderNo"
                                                            Header="Hydra Order No" />
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <!--
                                                            ColumnFilterPopupMode="Disabled": tắt popup lọc kiểu Excel trên header cột —
                                                            popup lồng trong popup của LookUpEdit là nguyên nhân treo/mất con trỏ khi bấm
                                                            "Clear Filter". Lọc theo cột vẫn dùng ShowAutoFilterRow (ô nhập trực tiếp
                                                            trong lưới, không phải popup) nên không mất chức năng tìm kiếm.
                                                            
                                                            AutoWidth="False" + BestFitModeOnSourceChange="VisibleRows": tắt chế độ ép cột
                                                            giãn vừa khung (AutoWidth) để mỗi cột được tự động "Best Fit" theo nội dung
                                                            (giống lệnh "Best Fit (all columns)" trong menu chuột phải) mỗi khi dữ liệu/lọc
                                                            thay đổi; HorizontalScrollbarVisibility="Auto" để cuộn ngang khi tổng bề rộng
                                                            cột vượt khung popup thay vì bị bóp chữ. Dùng "VisibleRows" thay vì "AllRows":
                                                            "AllRows" đo lại toàn bộ danh sách FG (dữ liệu gốc, có thể vài nghìn dòng) ngay
                                                            lần đầu ItemsSource được gán cho GridControl (do PopupContentTemplate chỉ dựng
                                                            1 lần khi mở popup lần đầu) — gây treo/rất lâu mới hiện data ở lần mở đầu tiên
                                                            sau khi mở app; "VisibleRows" chỉ đo các dòng đang render trong khung nhìn nên
                                                            nhanh hơn nhiều, độ rộng cột vẫn hợp lý.

                                                            SearchPanelParseMode="And": chi phối cách TableView.SearchString (ô tìm kiếm tự
                                                            dựng ở trên) được tách từ theo khoảng trắng — mỗi từ AND với nhau, mỗi từ chỉ
                                                            cần "chứa" (không cần liền nhau/đúng thứ tự), khác với AutoFilterRow vốn chỉ so
                                                            khớp nguyên cụm đã gõ trên đúng 1 cột.
                                                        -->
                                                        <dxg:TableView
                                                            AutoWidth="False"
                                                            BestFitModeOnSourceChange="VisibleRows"
                                                            ColumnFilterPopupMode="Disabled"
                                                            HorizontalScrollbarVisibility="Auto"
                                                            SearchPanelParseMode="And"
                                                            ShowAutoFilterRow="True"
                                                            ShowFilterPanelMode="ShowAlways" />
                                                    </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </StackPanel>

                                <!--  Barcode  -->
                                <StackPanel Grid.Row="5">


                                    <!--  Đèn trạng thái kết nối  -->
                                    <StackPanel Margin="0,4" Orientation="Horizontal">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,6,0"
                                            Fill="{Binding BarcodeStatus, Converter={StaticResource DriverStatusToColor}}" />
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Barcode / QR Scan" />
                                    </StackPanel>
                                    <TextBox
                                        KeyDown="_txtBarcode_KeyDown"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding BarcodeScannedValue}"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>

                                <!--  ✅ ✅ ✅ REMARK (FULL HEIGHT)  -->
                                <Grid Grid.Row="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Remark" />

                                    <TextBox
                                        Grid.Row="1"
                                        AcceptsReturn="True"
                                        Style="{StaticResource EditableFieldStyle}"
                                        Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Grid>

                            </Grid>
                        </ScrollViewer>

                    </Grid>
                </Border>
            </Grid>
            <!--  ────────────────── RIGHT AREA ──────────────────  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="428" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  TOTAL STEPS  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="#0D1117"
                            CornerRadius="4,4,0,0">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="SAMPLING LIST" />
                        </Border>

                        <!--  ItemsSource binding từ ViewModel  -->
                        <DataGrid
                            x:Name="dgSamplingList"
                            Grid.Row="1"
                            Padding="10"
                            ItemsSource="{Binding SamplesCollection}"
                            SelectionChanged="dgSamplingList_SelectionChanged"
                            Style="{StaticResource GridStyle}">
                            <DataGrid.Columns>

                                <!--  Action buttons – Command binding lên Window DataContext  -->
                                <DataGridTemplateColumn Width="125" IsReadOnly="False">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="Actions"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Command="{Binding DataContext.GridScaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Scale"
                                                    IsEnabled="{Binding AllowScale}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Command="{Binding DataContext.GridResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Reset"
                                                    IsEnabled="{Binding AllowScale}"
                                                    Style="{StaticResource WarningButton}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Command="{Binding DataContext.GridDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete"
                                                    IsEnabled="{Binding AllowScale}"
                                                    Style="{StaticResource DangerButton}"
                                                    Tag="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  STATUS  -->
                                <DataGridTemplateColumn Width="65">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="STATUS"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="0,0,0,14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusDotColor}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{Binding StatusText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="75"
                                    Binding="{Binding C004}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="MACHINE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C009}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="SAMPLE NUM"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C008}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="SIZE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C024, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="TOTAL WEIGHT (g)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        1st weighing: total weight (part + runner). Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C023, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="TOTAL PART (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        2nd weighing: part weight after separating the runner. Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C021, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="PART (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        = Total Part Weight (2nd weighing).
                                                    </TextBlock>
                                                </TextBlock.ToolTip>

                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C022, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="RUNNER WEIGHT (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        = (Total Weight − Total Part Weight × pairs/shot) / pairs/shot. Calculated after the 2nd weighing.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="300">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="FG / FG CODE"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding C014}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#78909C"
                                                    Text="{Binding C013}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C000}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="HYDRA ORDER"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="150">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="MAIN / MAIN CODE"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding C027}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#78909C"
                                                    Text="{Binding C026}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C005}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="ARTICLE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="200">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="CATEGORY / CATEGORY CODE"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding C034}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#78909C"
                                                    Text="{Binding C033}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C019}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="MACHINE GROUP"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C020}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="MOLD ID"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C018}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="MOLD PAIRS SHOT"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="200" TextWrapping="Wrap">
                                                        Pairs/shot of the mold (Hydra master data).
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C028}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="ACTUAL PARTITIONING"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="200" TextWrapping="Wrap">
                                                        Actual pairs/shot (prsShot) used to compute Runner Weight (C022).
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding C017}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="PPIC PARTITIONING"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="200" TextWrapping="Wrap">
                                                        PPIC pairs/shot (Hydra master data).
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C037}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="UNIT"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding C038}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="REMARKS"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding C012}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="QR CODE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!--  HISTORY + SCALE CARD + REF VALUES  -->
                <Border Grid.Row="1" Padding="0,4,0,0">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  History panel  -->
                        <Border
                            Grid.Column="0"
                            Margin="6,0,6,0"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="TitleRow" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  History header (click to toggle)  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="12,8"
                                    Background="#0D1117"
                                    CornerRadius="4,4,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HistoryHeader_Click">
                                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock
                                            FontFamily="Segoe UI"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding HistoryToggleText}"
                                            TextWrapping="WrapWithOverflow" />
                                    </StackPanel>

                                </Border>
                                <Border
                                    Grid.Row="1"
                                    MinHeight="60"
                                    Margin="10"
                                    CornerRadius="4,4,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HistoryHeader_Click">
                                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock
                                            FontSize="16"
                                            Style="{StaticResource LabelStyle}"
                                            Text="{Binding HistoryToggleTextDetail}"
                                            TextWrapping="WrapWithOverflow" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="16"
                                            Style="{StaticResource LabelStyle}"
                                            Text="{Binding HistoryToggleTextSecond}"
                                            TextWrapping="WrapWithOverflow" />
                                    </StackPanel>

                                </Border>
                                <!--  History grid – Visibility binding  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="10,0,10,10"
                                    Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <DataGrid
                                        x:Name="dgHistory"
                                        ItemsSource="{Binding HistoryCollection}"
                                        Style="{StaticResource GridStyle}">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="130"
                                                Binding="{Binding CreateDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                                ElementStyle="{StaticResource cellWrap}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Text="DATE / TIME"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding C024, StringFormat=F2}"
                                                ElementStyle="{StaticResource CenterCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Text="TOTAL WEIGHT (g)"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Width="125"
                                                Binding="{Binding C023, StringFormat=F2}"
                                                ElementStyle="{StaticResource CenterCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Text="TOTAL PART WEIGHT (g/prs)"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Width="115"
                                                Binding="{Binding C021, StringFormat=F2}"
                                                ElementStyle="{StaticResource CenterCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Text="PART WEIGHT (g/prs)"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Width="115"
                                                Binding="{Binding C022, StringFormat=F2}"
                                                ElementStyle="{StaticResource CenterCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Text="RUNNER / EXCESS MAT. WEIGHT (g/prs)"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Width="100" Binding="{Binding C011}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock
                                                        Margin="0,0,10,13"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Text="OPERATOR"
                                                        TextAlignment="Center"
                                                        TextWrapping="WrapWithOverflow" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Scale Card + Reference Values (Combined)  -->
                        <Border
                            Grid.Column="1"
                            Margin="0,0,6,0"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="TitleRow" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="60" />
                                </Grid.RowDefinitions>

                                <!--  ── Header: REFERENCE VALUES (left) + SCALE VALUE indicator (right) ──  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="12,8"
                                    Background="#0D1117"
                                    CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Left: title + subtitle  -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="Segoe UI"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="REFERENCE VALUES" />
                                        </StackPanel>
                                    </Grid>
                                </Border>


                                <!--  SCALE VALUE ROW (NEW)  -->
                                <Grid Grid.Row="1" Margin="0,8,0,8">

                                    <!--  3 cột align với DataGrid  -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <!--  Label  -->
                                        <ColumnDefinition Width="*" />
                                        <!--  STD  -->
                                        <ColumnDefinition Width="135" />
                                        <!--  ACTUAL  -->
                                        <ColumnDefinition Width="135" />
                                        <!--  Stable  -->
                                        <ColumnDefinition Width="150" />

                                    </Grid.ColumnDefinitions>

                                    <!--  LEFT: SCALE LABEL  -->
                                    <StackPanel
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,20,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,6,0"
                                            Fill="{Binding ScaleStatus, Converter={StaticResource DriverStatusToColor}}" />

                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Run
                                                FontSize="30"
                                                FontWeight="Bold"
                                                Text="SCALE VALUE " />
                                            <Run
                                                FontSize="30"
                                                FontWeight="Bold"
                                                Text="(g)" />
                                        </TextBlock>
                                    </StackPanel>


                                    <!--  CENTER BIG VALUE (SPAN STD + ACTUAL)  -->
                                    <!--
                                        Background="{Binding ScaleCardBackground}"
                                        BorderBrush="{Binding ScaleCardBorderBrush}"
                                    -->
                                    <Border
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0"
                                        Padding="20"
                                        BorderBrush="{Binding ScaleStable, Converter={StaticResource StableToForeground}}"
                                        BorderThickness="1.5"
                                        CornerRadius="8">

                                        <TextBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Consolas"
                                            FontSize="50"
                                            FontWeight="Bold"
                                            Foreground="#0D1117"
                                            IsReadOnly="{Binding ReadOnlyScale}"
                                            Text="{Binding ScaleValue}"
                                            TextAlignment="Center" />
                                    </Border>


                                    <!--  RIGHT: STABLE BADGE (TÁCH RIÊNG)  -->
                                    <!--<Border
                                        Grid.Column="4"
                                        Margin="10,0,0,0"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding ScaleStable, Converter={StaticResource StableToForeground}}"
                                        CornerRadius="4">

                                        <TextBlock
                                            Foreground="White"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="Stable Value" />
                                    </Border>-->

                                    <Button
                                        Grid.Column="4"
                                        Margin="10,0,5,0"
                                        Background="#0D1117"
                                        Command="{Binding SaveCommand}"
                                        IsEnabled="{Binding EnableBtnSaveScale}"
                                        Style="{StaticResource BottomBtn}">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,6,0" Text="💾" />
                                            <TextBlock Text="Save" />
                                        </StackPanel>

                                    </Button>

                                </Grid>

                                <!--  ── REFERENCE VALUES DataGrid ──  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="0,0,0,15"
                                    Background="{Binding ScaleTare, Converter={StaticResource TareToBackground}}"
                                    BorderBrush="#E0E7EF"
                                    BorderThickness="0,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DataGrid
                                            x:Name="dgRefValues"
                                            Grid.Row="0"
                                            Padding="0"
                                            Grid.IsSharedSizeScope="True"
                                            ItemsSource="{Binding RefRowsCollection}"
                                            RowStyle="{StaticResource RefRowStyle}"
                                            Style="{StaticResource GridStyle}">
                                            <DataGrid.Columns>

                                                <!--  #  -->
                                                <DataGridTemplateColumn Width="46" Header="#">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="8,9,8,4" VerticalAlignment="Center">
                                                                <Border
                                                                    Width="30"
                                                                    Height="30"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="#0D1117"
                                                                    CornerRadius="15">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        FontWeight="Bold"
                                                                        Foreground="White"
                                                                        Text="{Binding No}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!--  FIELD (Unit)  -->
                                                <DataGridTemplateColumn Width="*" Header="WEIGHT TYPE">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel
                                                                Margin="10,10,10,12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    Padding="10,0,0,0"
                                                                    FontSize="15"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding FieldName}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Padding="10,4,0,0"
                                                                    FontSize="10"
                                                                    Foreground="#78909C"
                                                                    Text="{Binding Unit, StringFormat='[{0}]'}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!--  STD  -->
                                                <DataGridTemplateColumn Width="135">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock
                                                                Text="STANDARD"
                                                                TextAlignment="Center"
                                                                TextWrapping="Wrap"
                                                                ToolTipService.ShowDuration="20000">
                                                                <TextBlock.ToolTip>
                                                                    <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                                                        Most recent value.
                                                                    </TextBlock>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.HeaderTemplate>

                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="4,4"
                                                                Padding="10,6"
                                                                HorizontalAlignment="Stretch"
                                                                Background="{Binding Tolerance, Converter={StaticResource ToleranceToBrush}}"
                                                                BorderBrush="{Binding Tolerance, Converter={StaticResource ToleranceToBorderBrush}}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="5">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="15"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Tolerance, Converter={StaticResource ToleranceToFore}}"
                                                                    Text="{Binding StdDisplay}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!--  ACTUAL  -->
                                                <DataGridTemplateColumn Width="135">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock
                                                                Text="ACTUAL"
                                                                TextAlignment="Center"
                                                                TextWrapping="Wrap"
                                                                ToolTipService.ShowDuration="20000">
                                                                <TextBlock.ToolTip>
                                                                    <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                                                        Current weighing value.
                                                                    </TextBlock>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.HeaderTemplate>

                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="4,4"
                                                                Padding="10,6"
                                                                HorizontalAlignment="Stretch"
                                                                Background="{Binding Tolerance, Converter={StaticResource ToleranceToBrush}}"
                                                                BorderBrush="{Binding Tolerance, Converter={StaticResource ToleranceToBorderBrush}}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="5">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="15"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Tolerance, Converter={StaticResource ToleranceToFore}}"
                                                                    Text="{Binding ActualDisplay}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!--  Δ  -->
                                                <DataGridTemplateColumn Width="150">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock
                                                                Text="Δ"
                                                                TextAlignment="Center"
                                                                TextWrapping="Wrap"
                                                                ToolTipService.ShowDuration="20000">
                                                                <TextBlock.ToolTip>
                                                                    <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                                                        Difference between the current and most recent readings.
                                                                    </TextBlock>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.HeaderTemplate>

                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>

                                                            <TextBlock
                                                                Margin="13"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="{Binding Tolerance, Converter={StaticResource ToleranceToFore}}"
                                                                Text="{Binding DeltaDisplay}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Grid.IsSharedSizeScope="True">
                                            <TextBlock
                                                Margin="0,0,0,0"
                                                FontSize="16"
                                                Foreground="#B0BEC5"
                                                Style="{StaticResource LabelStyle}"
                                                Text="{Binding DeltaInformation}"
                                                TextWrapping="WrapWithOverflow" />
                                        </StackPanel>
                                    </Grid>

                                </Border>

                                <!--  ═══════════════════════════════ BOTTOM BAR ═════════════════════════════  -->
                                <Border Grid.Row="3">
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="20,0"
                                            Background="#E65100"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource BottomBtn}">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" Text="❌" />
                                                <TextBlock Text="Cancel" />
                                            </StackPanel>

                                        </Button>
                                        <Button
                                            Padding="20,0"
                                            Background="#2E7D32"
                                            Command="{Binding ConfirmCommand}"
                                            Style="{StaticResource BottomBtn}">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" Text="✔" />
                                                <TextBlock Text="Confirm" />
                                            </StackPanel>

                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ═══════════════════════════════ LOADING OVERLAY ═════════════════════════  -->
        <Grid
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Background="#80000000"
            Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}">
            <Border
                MinWidth="240"
                Padding="40,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#1565C0"
                        Text="Loading…" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#78909C"
                        Text="Please wait" />
                    <Button
                        Margin="0,16,0,0"
                        Padding="20,6"
                        HorizontalAlignment="Center"
                        Command="{Binding CancelLoadCommand}"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelLoadEnabled}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
