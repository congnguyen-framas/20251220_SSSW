<Window x:Class="SSSW.UI.WPF.ShotWeightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:vm="clr-namespace:SSSW.UI.WPF.ViewModels"
        mc:Ignorable="d"
        Title="IT – Shotweight Station"
        Height="1080" Width="1920"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <!-- Merge style dictionary -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════ TITLE BAR ═══════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D1117"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="framas"
                           Foreground="White" FontWeight="Bold" FontSize="16"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="14,0,10,0"/>

                <!-- Binding WindowTitle từ ViewModel -->
                <TextBlock Grid.Column="2"
                           Text="{Binding WindowTitle}"
                           Foreground="#90A4AE" FontSize="13"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <StackPanel Grid.Column="3"/>

                <!-- Binding UserName từ ViewModel -->
                <TextBlock Grid.Column="4"
                           Text="{Binding UserName}"
                           Foreground="#90A4AE" FontSize="12"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding ReloadCommand}"
                            Content="&#xE72C;" ToolTip="Reload"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding HistoryViewCommand}"
                            Content="&#xE81C;" ToolTip="History"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding HydraCommand}"
                            Content="&#xE895;" ToolTip="Hydra"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding SettingsCommand}"
                            Content="&#xE713;" ToolTip="Settings"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding UpdateCommand}"
                            Content="&#xE777;" ToolTip="Update"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Content="&#xE921;" ToolTip="Minimize"
                            Click="btnMinimize_Click"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Content="&#xE922;" ToolTip="Maximize"
                            Click="btnMaximize_Click"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Background="#C62828" Content="&#xE8BB;" ToolTip="Close"
                            Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════ MAIN CONTENT ════════════════════════════ -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────── LEFT PANEL – STEP INFORMATION ────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="4,4,0,0" Padding="10,6">
                        <TextBlock Text="STEP INFORMATION" Foreground="White"
                                   FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,8">

                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding StepName, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" MaxLines="3" Margin="0,0,0,8"/>

                            <TextBlock Text="Code" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding StepCode, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     Margin="0,0,0,8"/>

                            <!-- Machine + Quantity -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Machine" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Machine, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Quantity" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Qty, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Partitioning + Toggle -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Partitioning (prs)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="tbActualPairs"
                                             Text="{Binding ActualPairs, Mode=OneWay}"
                                             IsReadOnly="{Binding IsActualPairsReadOnly}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             KeyDown="tbActualPairs_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="Adj." Style="{StaticResource LabelStyle}"
                                               HorizontalAlignment="Center"/>
                                    <!-- Binding AllowPartitionAdj two-way -->
                                    <CheckBox IsChecked="{Binding AllowPartitionAdj, Mode=TwoWay}"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Runner + Usage% -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Runner" Style="{StaticResource LabelStyle}"/>
                                    <!-- Binding RunnerText two-way -->
                                    <ComboBox x:Name="cbRunner"
                                              SelectedValue="{Binding RunnerText, Mode=TwoWay}"
                                              FontFamily="Segoe UI" FontSize="20" Height="Auto">
                                        <ComboBoxItem Content="YES"/>
                                        <ComboBoxItem Content="NO"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Usage %" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="tbUsagePct"
                                             Text="{Binding UsagePct, Mode=OneWay}"
                                             IsReadOnly="{Binding IsUsagePctReadOnly}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             KeyDown="tbUsagePct_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- Size + SeqIndex -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Size" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Size, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Seq. Index" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding StepIndex, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="FG Description" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FgName, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" MaxLines="3" Margin="0,0,0,8"/>

                            <TextBlock Text="FG Item Code" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FgItemCode, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Remark" Style="{StaticResource LabelStyle}"/>
                            <!-- Binding Remark two-way, setter trong VM sync _remarkFinal -->
                            <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableFieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" Margin="0,0,0,8"/>

                            <TextBlock Text="Select Step" Style="{StaticResource LabelStyle}"/>

                            <!-- DevExpress LookUpEdit: ItemsSource từ ViewModel, event bridge ở code-behind -->
                            <dxg:LookUpEdit x:Name="cbStepName"
                                            ItemsSource="{Binding StepCodeMaster}"
                                            DisplayMember="StepItemName"
                                            ValueMember="StepItemCode"
                                            AutoPopulateColumns="False"
                                            AutoComplete="True"
                                            PopupWidth="1000"
                                            PopupHeight="500"
                                            EditValueChanged="cbStepName_EditValueChangedAsync"
                                            FontSize="20">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEditStyleSettings AllowColumnFiltering="True"/>
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl" IsFilterEnabled="True">
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="Machine"      Header="Machine"
                                                                FilterPopupMode="Excel" ColumnFilterMode="DisplayText"/>
                                                <dxg:GridColumn FieldName="StepItemCode" Header="Step Code"/>
                                                <dxg:GridColumn FieldName="StepItemName" Header="Step Name"/>
                                                <dxg:GridColumn FieldName="Size"         Header="Size"/>
                                                <dxg:GridColumn FieldName="HydraOrderNo" Header="Hydra Order No"/>
                                                <dxg:GridColumn FieldName="FT601Id"      Header="FT601 Id"/>
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True"
                                                               ShowFilterPanelMode="ShowAlways"
                                                               ShowAutoFilterRow="True"/>
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ────────────────── RIGHT AREA ────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="350"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOTAL STEPS -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4,4,0,0" Padding="10,6">
                            <TextBlock Text="TOTAL STEPS" Foreground="White"
                                       FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>

                        <!-- ItemsSource binding từ ViewModel -->
                        <DataGrid Grid.Row="1" x:Name="dgTotalSteps"
                                  ItemsSource="{Binding StepsCollection}"
                                  Style="{StaticResource GridStyle}"
                                  SelectionChanged="dgTotalSteps_SelectionChanged">
                            <DataGrid.Columns>

                                <!-- Status strip -->
                                <DataGridTemplateColumn Width="6" Header="" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="4" HorizontalAlignment="Left">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding StatusBarColor}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Action buttons – Command binding lên Window DataContext -->
                                <DataGridTemplateColumn Header="Actions" Width="110" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Scale" Tag="{Binding}"
                                                        Margin="2,1" FontSize="10" Padding="4,2"
                                                        Command="{Binding DataContext.GridScaleCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Reset" Tag="{Binding}"
                                                        Margin="2,1" FontSize="10" Padding="4,2"
                                                        Command="{Binding DataContext.GridResetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- STATUS -->
                                <DataGridTemplateColumn Header="STATUS" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="4,0">
                                                <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusDotColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="MACHINE" Binding="{Binding C004}" Width="80"/>

                                <DataGridTemplateColumn Header="MAIN / MAIN CODE" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding C027}" FontWeight="Bold"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding C026}" FontSize="10"
                                                           Foreground="#78909C"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Sequence Step"
                                                    Binding="{Binding C015}" Width="80"
                                                    ElementStyle="{StaticResource RightCell}"/>

                                <DataGridTemplateColumn Header="ITEM / STEP CODE" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding C003}" FontWeight="Bold"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding C002}" FontSize="10"
                                                           Foreground="#78909C"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SIZE" Binding="{Binding C008}" Width="60"/>
                                <DataGridTextColumn Header="TOTAL W (g)"
                                                    Binding="{Binding C024, StringFormat=F2}"
                                                    Width="100"
                                                    ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="TOTAL PW (g/prs)"
                                                    Binding="{Binding C023, StringFormat=F2}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="PART WT. (g/prs)"
                                                    Binding="{Binding C021, StringFormat=F2}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="RUNNER (g/prs)"
                                                    Binding="{Binding C022, StringFormat=F2}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="OPERATOR"
                                                    Binding="{Binding C011}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- RFID + Barcode row -->
                <Border Grid.Row="1" Background="Transparent" Padding="6,3,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- RFID -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RFID / Employee ID"
                                               Style="{StaticResource LabelStyle}"/>
                                    <!-- WinForms host: gán từ code-behind -->
                                    <Border x:Name="rfidHost" Height="35" Background="#FAFAFA"
                                            BorderBrush="#CFD8DC" BorderThickness="1" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Employee Name"
                                               Style="{StaticResource LabelStyle}"/>
                                    <!-- Binding RfidName từ ViewModel -->
                                    <TextBox x:Name="tbRFIDName"
                                             Text="{Binding RfidName, Mode=TwoWay}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             Height="32"
                                             KeyDown="tbRFIDName_KeyDown"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Barcode -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Margin="10,8">
                                <TextBlock Text="Barcode / QR Scan"
                                           Style="{StaticResource LabelStyle}"/>
                                <!-- WinForms host: gán từ code-behind -->
                                <Border x:Name="barcodeHost" Height="35" Background="#FAFAFA"
                                        BorderBrush="#CFD8DC" BorderThickness="1" Padding="6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- HISTORY + SCALE CARD + REF VALUES -->
                <Border Grid.Row="2" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- History panel -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- History header (click to toggle) -->
                                <Border Grid.Row="0" Background="#1565C0" CornerRadius="4,4,0,0"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="HistoryHeader_Click"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding HistoryToggleText}"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="12" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- History grid – Visibility binding -->
                                <Border Grid.Row="1"
                                        Visibility="{Binding IsHistoryExpanded,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        MaxHeight="200">
                                    <DataGrid x:Name="dgHistory"
                                              ItemsSource="{Binding HistoryCollection}"
                                              Style="{StaticResource GridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DATE / TIME"
                                                                Binding="{Binding CreateDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                                                Width="130"/>
                                            <DataGridTextColumn Header="TOTAL W (g)"
                                                                Binding="{Binding C024, StringFormat=F2}"
                                                                Width="100"
                                                                ElementStyle="{StaticResource RightCell}"/>
                                            <DataGridTextColumn Header="TOTAL PW (g/prs)"
                                                                Binding="{Binding C023, StringFormat=F2}"
                                                                Width="110"
                                                                ElementStyle="{StaticResource RightCell}"/>
                                            <DataGridTextColumn Header="PART WT. (g/prs)"
                                                                Binding="{Binding C021, StringFormat=F2}"
                                                                Width="110"
                                                                ElementStyle="{StaticResource RightCell}"/>
                                            <DataGridTextColumn Header="RUNNER (g/prs)"
                                                                Binding="{Binding C022, StringFormat=F2}"
                                                                Width="110"
                                                                ElementStyle="{StaticResource RightCell}"/>
                                            <DataGridTextColumn Header="OPERATOR"
                                                                Binding="{Binding C011}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Scale Card + Reference Values -->
                        <Border Grid.Column="1" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- SCALE VALUE Card -->
                                <Border Grid.Row="0" x:Name="pnlScaleCard"
                                        Style="{StaticResource CardStyle}"
                                        BorderThickness="2"
                                        BorderBrush="{Binding ScaleCardBorderBrush}"
                                        Background="White">
                                    <StackPanel>
                                        <Border Background="#1565C0" CornerRadius="4,4,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                                                <TextBlock Text="SCALE VALUES" Foreground="White"
                                                           FontWeight="Bold" FontSize="12"
                                                           FontFamily="Segoe UI"/>
                                                <TextBlock Text=" · gram (g)" Foreground="White"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Padding="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Binding ScaleDisplay từ ViewModel -->
                                        <TextBlock Text="{Binding ScaleDisplay}"
                                                   FontFamily="Consolas" FontSize="42"
                                                   FontWeight="Bold" Foreground="#212121"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,4"/>

                                        <!-- WinForms scale hardware host -->
                                        <Border x:Name="scaleHost" Height="32"
                                                Background="#FAFAFA"
                                                BorderBrush="#CFD8DC" BorderThickness="1"/>
                                    </StackPanel>
                                </Border>

                                <!-- REFERENCE VALUES DataGrid -->
                                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#1565C0"
                                                CornerRadius="4,4,0,0" Padding="10,6">
                                            <TextBlock Text="REFERENCE VALUES" Foreground="White"
                                                       FontWeight="Bold" FontSize="12"
                                                       FontFamily="Segoe UI"/>
                                        </Border>

                                        <!-- ItemsSource binding từ ViewModel -->
                                        <DataGrid Grid.Row="1" x:Name="dgRefValues"
                                                  ItemsSource="{Binding RefRowsCollection}"
                                                  Style="{StaticResource GridStyle}"
                                                  RowStyle="{StaticResource RefRowStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="#" Width="44">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Width="26" Height="26" CornerRadius="13"
                                                                    Background="#1565C0"
                                                                    HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding No}"
                                                                           Foreground="White"
                                                                           FontWeight="Bold" FontSize="11"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="FIELD (Unit)" Width="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FieldName}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Unit}"
                                                                           FontSize="10"
                                                                           Foreground="#78909C"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="STD"
                                                                    Binding="{Binding StdDisplay}"
                                                                    Width="110"
                                                                    ElementStyle="{StaticResource RightCellBold}"/>
                                                <DataGridTextColumn Header="Δ"
                                                                    Binding="{Binding DeltaDisplay}"
                                                                    Width="90"
                                                                    ElementStyle="{StaticResource RightCellBold}"/>
                                                <DataGridTextColumn Header="ACTUAL"
                                                                    Binding="{Binding ActualDisplay}"
                                                                    Width="110"
                                                                    ElementStyle="{StaticResource RightCellBold}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════ BOTTOM BAR ══════════════════════════════ -->
        <Border Grid.Row="2" Margin="3,6,3,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="↓  Save"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding SaveCommand}"
                        Background="#1A237E" Padding="20,0"/>
                <Button Content="Cancel"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding CancelCommand}"
                        Background="#E65100" Padding="20,0"/>
                <Button Content="Confirm"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding ConfirmCommand}"
                        Background="#2E7D32" Padding="20,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════ LOADING OVERLAY ═════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}"
             d:Visibility="Collapsed"
              Background="#80000000">
            <Border Background="White" CornerRadius="8"
                    Padding="40,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="240">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Loading…" FontSize="18" FontWeight="Bold"
                               Foreground="#1565C0" HorizontalAlignment="Center"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock Text="Please wait" FontSize="12" Foreground="#78909C"
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelLoadCommand}"
                            IsEnabled="{Binding IsCancelLoadEnabled}"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Padding="20,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
