                                                                    <TextBlock Width="250" TextWrapping="WrapWithOverflow">
                                                                        Difference between the current and most recent readings.
                                                                    </TextBlock>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.HeaderTemplate>

                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>

                                                            <TextBlock
                                                                Margin="13"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="{Binding Tolerance, Converter={StaticResource ToleranceToFore}}"
                                                                Text="{Binding DeltaDisplay}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Grid.IsSharedSizeScope="True">
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="20"
                                                Foreground="#B0BEC5"
                                                Style="{StaticResource LabelStyle}"
                                                Text="{Binding DeltaInformation}" />
                                        </StackPanel>
                                    </Grid>

                                </Border>

                                <!--  ═══════════════════════════════ BOTTOM BAR ═════════════════════════════  -->
                                <Border Grid.Row="3">
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="20,0"
                                            Background="#E65100"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource BottomBtn}">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" Text="❌" />
                                                <TextBlock Text="Cancel" />
                                            </StackPanel>

                                        </Button>
                                        <Button
                                            Padding="20,0"
                                            Background="#2E7D32"
                                            Command="{Binding ConfirmCommand}"
                                            Style="{StaticResource BottomBtn}">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,6,0" Text="✔" />
                                                <TextBlock Text="Confirm" />
                                            </StackPanel>

                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ═══════════════════════════════ LOADING OVERLAY ═════════════════════════  -->
        <Grid
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Background="#80000000"
            Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}">
            <Border
                MinWidth="240"
                Padding="40,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#1565C0"
                        Text="Loading…" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#78909C"
                        Text="Please wait" />
                    <Button
                        Margin="0,16,0,0"
                        Padding="20,6"
                        HorizontalAlignment="Center"
                        Command="{Binding CancelLoadCommand}"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelLoadEnabled}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
