<Window x:Class="SSSW.UI.WPF.ShotWeightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:vm="clr-namespace:SSSW.UI.WPF.ViewModels"
        mc:Ignorable="d"
        Title="IT – Shotweight Station"
        Height="1080" Width="1920"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <!-- Merge style dictionary -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════ TITLE BAR ═══════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D1117"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="framas"
                           Foreground="White" FontWeight="Bold" FontSize="16"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="14,0,10,0"/>

                <!-- Binding WindowTitle từ ViewModel -->
                <TextBlock Grid.Column="2"
                           Text="{Binding WindowTitle}"
                           Foreground="#90A4AE" FontSize="13"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <StackPanel Grid.Column="3"/>

                <!-- Binding UserName từ ViewModel -->
                <TextBlock Grid.Column="4"
                           Text="{Binding UserName}"
                           Foreground="#90A4AE" FontSize="12"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding ReloadCommand}"
                            Content="&#xE72C;" ToolTip="Reload"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding HistoryViewCommand}"
                            Content="&#xE81C;" ToolTip="History"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding HydraCommand}"
                            Content="&#xE895;" ToolTip="Hydra"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding SettingsCommand}"
                            Content="&#xE713;" ToolTip="Settings"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Command="{Binding UpdateCommand}"
                            Content="&#xE777;" ToolTip="Update"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Content="&#xE921;" ToolTip="Minimize"
                            Click="btnMinimize_Click"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Content="&#xE922;" ToolTip="Maximize"
                            Click="btnMaximize_Click"/>
                    <Button Style="{StaticResource TitleIconBtn}"
                            Background="#C62828" Content="&#xE8BB;" ToolTip="Close"
                            Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════ MAIN CONTENT ════════════════════════════ -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────── LEFT PANEL – STEP INFORMATION ────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border  Style="{StaticResource CardStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4,4,0,0" Padding="12,8">
                            <TextBlock Text="STEP INFORMATION" Foreground="White"
                                   FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">

                                <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding StepName, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" MaxLines="3" Margin="0,0,0,8"/>

                                <TextBlock Text="Code" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding StepCode, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     Margin="0,0,0,8"/>

                                <!-- Machine + Quantity -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Machine" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding Machine, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quantity" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding Qty, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Partitioning + Toggle -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Partitioning (prs)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="tbActualPairs"
                                             Text="{Binding ActualPairs, Mode=OneWay}"
                                             IsReadOnly="{Binding IsActualPairsReadOnly}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             KeyDown="tbActualPairs_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Text="Adj." Style="{StaticResource LabelStyle}"
                                               HorizontalAlignment="Center"/>
                                        <!-- Binding AllowPartitionAdj two-way -->
                                        <CheckBox IsChecked="{Binding AllowPartitionAdj, Mode=TwoWay}"
                                              HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Runner + Usage% -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Runner" Style="{StaticResource LabelStyle}"/>
                                        <!-- Binding RunnerText two-way -->
                                        <ComboBox x:Name="cbRunner"
                                              SelectedValue="{Binding RunnerText, Mode=TwoWay}"
                                              FontFamily="Segoe UI" FontSize="20" Height="Auto">
                                            <ComboBoxItem Content="YES"/>
                                            <ComboBoxItem Content="NO"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Usage %" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="tbUsagePct"
                                             Text="{Binding UsagePct, Mode=OneWay}"
                                             IsReadOnly="{Binding IsUsagePctReadOnly}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             KeyDown="tbUsagePct_KeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Size + SeqIndex -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Size" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding Size, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Seq. Index" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding StepIndex, Mode=OneWay}"
                                             Style="{StaticResource FieldStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="FG Description" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding FgName, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" MaxLines="3" Margin="0,0,0,8"/>

                                <TextBlock Text="FG Item Code" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding FgItemCode, Mode=OneWay}"
                                     Style="{StaticResource FieldStyle}"
                                     Margin="0,0,0,8"/>

                                <TextBlock Text="Remark" Style="{StaticResource LabelStyle}"/>
                                <!-- Binding Remark two-way, setter trong VM sync _remarkFinal -->
                                <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableFieldStyle}"
                                     TextWrapping="Wrap" MinLines="2" Margin="0,0,0,8"/>

                                <TextBlock Text="Select Step" Style="{StaticResource LabelStyle}"/>

                                <!-- DevExpress LookUpEdit: ItemsSource từ ViewModel, event bridge ở code-behind -->
                                <dxg:LookUpEdit x:Name="cbStepName"
                                            ItemsSource="{Binding StepCodeMaster}"
                                            DisplayMember="StepItemName"
                                            ValueMember="StepItemCode"
                                            AutoPopulateColumns="False"
                                            AutoComplete="True"
                                            PopupWidth="1000"
                                            PopupHeight="500"
                                            EditValueChanged="cbStepName_EditValueChangedAsync"
                                            FontSize="20"
                                            TextWrapping="Wrap"
                                            >
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:LookUpEditStyleSettings AllowColumnFiltering="True"/>
                                    </dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" IsFilterEnabled="True">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="Machine"      Header="Machine"
                                                                FilterPopupMode="Excel" ColumnFilterMode="DisplayText"/>
                                                    <dxg:GridColumn FieldName="StepItemCode" Header="Step Code"/>
                                                    <dxg:GridColumn FieldName="StepItemName" Header="Step Name"/>
                                                    <dxg:GridColumn FieldName="Size"         Header="Size"/>
                                                    <dxg:GridColumn FieldName="HydraOrderNo" Header="Hydra Order No"/>
                                                    <dxg:GridColumn FieldName="FT601Id"      Header="FT601 Id"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="True"
                                                               ShowFilterPanelMode="ShowAlways"
                                                               ShowAutoFilterRow="True"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <!-- ────────────────── RIGHT AREA ────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="428"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOTAL STEPS -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="4" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4,4,0,0" Padding="12,8">
                            <TextBlock Text="TOTAL STEPS" Foreground="White"
                                       FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>

                        <!-- ItemsSource binding từ ViewModel -->
                        <DataGrid Grid.Row="1" x:Name="dgTotalSteps"
                                  ItemsSource="{Binding StepsCollection}"
                                  Style="{StaticResource GridStyle}"
                                  SelectionChanged="dgTotalSteps_SelectionChanged"
                                  Padding="10">
                            <DataGrid.Columns>

                                <!-- Status strip -->
                                <!--<DataGridTemplateColumn Width="6" Header="" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="4" HorizontalAlignment="Left" Margin="1,4,1,4">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding StatusBarColor}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>-->

                                <!-- Action buttons – Command binding lên Window DataContext -->
                                <DataGridTemplateColumn Width="130" IsReadOnly="False">
                                    <!-- HEADER TEMPLATE -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Actions"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!-- CELL TEMPLATE -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="6,5">
                                                <Button Content="Scale" Tag="{Binding}"
                                                        Command="{Binding DataContext.GridScaleCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"/>
                                                <Button Content="Reset" Tag="{Binding}"
                                                        Command="{Binding DataContext.GridResetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource WarningButton}"/>
                                                <Button Content="Delete" Tag="{Binding}"
                                                        Command="{Binding DataContext.GridDeleteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- STATUS -->
                                <DataGridTemplateColumn Width="90">
                                    <!-- HEADER TEMPLATE -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="STATUS"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!-- CELL TEMPLATE -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Margin="0,0,0,14">
                                                <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusDotColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn  Binding="{Binding C004}"
                                                     Width="80"
                                                     ElementStyle="{StaticResource LeftCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="MACHINE" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="200">
                                    <!-- HEADER TEMPLATE -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="MAIN / MAIN CODE"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!-- CELL TEMPLATE -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,0">
                                                <TextBlock Text="{Binding C027}" FontWeight="Bold"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding C026}" FontSize="10"
                                                           Foreground="#78909C"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTextColumn  Binding="{Binding C015}"
                                                      Width="80"
                                                      ElementStyle="{StaticResource RightCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="SEQUENCE STEP" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="200">
                                    <!-- HEADER TEMPLATE -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="STEP / STEP CODE"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!-- CELL TEMPLATE -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding C003}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding C002}"
                                                           FontSize="10"
                                                           Foreground="#78909C"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn  Binding="{Binding C008}"
                                                     Width="60"
                                                     ElementStyle="{StaticResource LeftCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="SIZE" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn  Binding="{Binding C024,StringFormat=F2}"
                                                     Width="100"
                                                     ElementStyle="{StaticResource RightCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="TOTAL WEIGHT INJECTION (g)" TextWrapping="WrapWithOverflow" TextAlignment="Center"
                                                       ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock TextWrapping="Wrap" Width="250">
                                                                Total weight after ejection. Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                             </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn  Binding="{Binding C023,StringFormat=F2}"
                                                     Width="100"
                                                     ElementStyle="{StaticResource RightCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="TOTAL PART WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"
                                                       ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock TextWrapping="Wrap" Width="250">
                                                                Includes the par of the current step and previous steps. Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn  Binding="{Binding C021,StringFormat=F2}"
                                                     Width="100"
                                                     ElementStyle="{StaticResource RightCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="PART WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"
                                                       ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock TextWrapping="Wrap" Width="250">
                                                                Part weight of the current step. Calculation = (TOTAL PART WEIGHT − TOTAL PART WEIGHT of the previous step) / pairs per shot
                                                    </TextBlock>
                                                </TextBlock.ToolTip>

                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn  Binding="{Binding C022,StringFormat=F2}"
                                                      Width="100"
                                                      ElementStyle="{StaticResource RightCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="RUNNER / EXCESS MAT. WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"
                                                       ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock TextWrapping="Wrap" Width="250">
                                                             Runner weight of the current step. Calculation = (TOTAL WEIGHT INJECTION - TOTAL PART WEIGHT) / pairs per shot
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn  Binding="{Binding C011}"
                                                      Width="90"
                                                      ElementStyle="{StaticResource LeftCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="OPERATOR" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- RFID + Barcode row -->
                <Border Grid.Row="1" Background="Transparent" Padding="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── RFID Card ── -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}" 
                                Padding="5">
                            <Grid>
                                <!-- chia 2 cột -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ===== LEFT COLUMN ===== -->
                                <Grid Grid.Column="0" Margin="0,0,5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Label -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- status dot -->
                                        <Ellipse Width="10" Height="10"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding RfidStatus, Converter={StaticResource DriverStatusToColor}}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="RFID / Employee ID"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- TextBox -->
                                    <TextBox Grid.Row="1"
                                             Text="{Binding RfidCardCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldStyle}"
                                             Height="36"
                                             HorizontalAlignment="Stretch"
                                            IsReadOnly="{Binding ReadOnly}"
                                            KeyDown="_txtRFID_KeyDown"/>
                                </Grid>

                                <!-- ===== RIGHT COLUMN ===== -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="0"
                                               Text="Employee Name"
                                               Style="{StaticResource LabelStyle}"/>

                                    <!-- TextBox -->
                                    <TextBox Name="tbRFIDName" Grid.Row="1"
                                             Text="{Binding RfidName, Mode=OneWay}"
                                             Style="{StaticResource EditableFieldStyle}"
                                             Height="36"
                                             HorizontalAlignment="Stretch"/>
                                </Grid>

                            </Grid>
                        </Border>

                        <!-- ── Barcode Card ── -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                                Padding="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10"
                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                             Fill="{Binding BarcodeStatus,
                                                    Converter={StaticResource DriverStatusToColor}}"/>
                                    <TextBlock Text="Barcode / QR Scan"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!--
                                    TextBox WPF native — thay thế WinForms BarcodeButtonEdit.
                                    Binding BarcodeScannedValue (từ ScanAndScale.Core BarcodeDriver).
                                -->
                                <TextBox Name="_txtBarcode" Text="{Binding BarcodeScannedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldStyle}"
                                         Height="36" FontSize="16"
                                         Foreground="#1565C0"
                                         Background="#F0F7FF"
                                         MinWidth="260"
                                         IsReadOnly="{Binding ReadOnly}"
                                         KeyDown="_txtBarcode_KeyDown"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- HISTORY + SCALE CARD + REF VALUES -->
                <Border Grid.Row="2" Padding="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- History panel -->
                        <Border Grid.Column="0" Margin="6,0,6,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- History header (click to toggle) -->
                                <Border Grid.Row="0" Background="#1565C0"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="HistoryHeader_Click"
                                        CornerRadius="4,4,0,0" Padding="12,8">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HistoryToggleText}"
                                                   Foreground="White" FontWeight="Bold"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   TextWrapping="WrapWithOverflow"/>
                                        <TextBlock Text="{Binding HistoryToggleTextSecond}"
                                                   Foreground="#B0BEC5" FontSize="10"
                                                   FontFamily="Segoe UI" Margin="0,3,0,0"
                                                   TextWrapping="WrapWithOverflow"/>
                                    </StackPanel>

                                </Border>

                                <!-- History grid – Visibility binding -->
                                <Border Grid.Row="1"
                                        Visibility="{Binding IsHistoryExpanded,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        Padding="10">
                                    <DataGrid x:Name="dgHistory"
                                              ItemsSource="{Binding HistoryCollection}"
                                              Style="{StaticResource GridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn  Binding="{Binding CreateDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                                                Width="130"
                                                                 ElementStyle="{StaticResource cellWrap}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="DATE / TIME" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding C024, StringFormat=F2}"
                                                                Width="100"
                                                                ElementStyle="{StaticResource RightCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="TOTAL WEIGHT (g)" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding C024, StringFormat=F2}"
                                                                Width="125"
                                                                ElementStyle="{StaticResource RightCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="TOTAL PART WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding C021, StringFormat=F2}"
                                                                Width="115"
                                                                ElementStyle="{StaticResource RightCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="PART WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding C022, StringFormat=F2}"
                                                                 Width="115"
                                                                 ElementStyle="{StaticResource RightCell}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="RUNNER / EXCESS MAT. WEIGHT (g/prs)" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Binding="{Binding C011, StringFormat=F2}"
                                                                 Width="100">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="OPERATOR" TextWrapping="WrapWithOverflow" TextAlignment="Center"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Scale Card + Reference Values (Combined) -->
                        <Border Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource CardStyle}">
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ── Header: REFERENCE VALUES (left) + SCALE VALUE indicator (right) ── -->
                                <Border Grid.Row="0" Background="#1565C0"
                                        CornerRadius="4,4,0,0" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: title + subtitle -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="REFERENCE VALUES"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="13" FontFamily="Segoe UI"/>
                                            <TextBlock Text= "{Binding DeltaInformation}"
                                                       Foreground="#B0BEC5" FontSize="10"
                                                       FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Right: SCALE VALUE label + status dot -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Ellipse Width="10" Height="10"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding ScaleStatus,
                                                            Converter={StaticResource DriverStatusToColor}}"/>
                                            <TextBlock Text="SCALE VALUE (G)"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="11" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Scale Value Display ── -->
                                <Border Grid.Row="1"
                                        Background="{Binding ScaleTare,
                                                     Converter={StaticResource TareToBackground}}"
                                        BorderBrush="#E0E7EF" BorderThickness="0,0,0,1"
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Stable / Tare badges -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding ScaleStable,
                                                                 Converter={StaticResource StableToForeground}}"
                                                    Visibility="{Binding ReadOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                    >
                                                <TextBlock Foreground="White" 
                                                           Background="#F0F7FF"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Text="Stable Value"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Background="#E53935"
                                                    Visibility="{Binding ScaleTare,
                                                                 Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Foreground="White" FontSize="11"
                                                           FontWeight="Bold" Text="TARE"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Right: Large scale number — đổi màu theo tolerance -->
                                        <Border Grid.Column="1"
                                                BorderBrush="{Binding ScaleCardBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8" 
                                                Background="{Binding ScaleCardBackground}"
                                                Padding="10">
                                            <TextBox Name="_txtScale"
                                                     Text="{Binding ScaleValue,
                                                            UpdateSourceTrigger=LostFocus}"
                                                     IsReadOnly="{Binding ReadOnly}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas" FontSize="44"
                                                     FontWeight="Bold"
                                                     HorizontalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     MinWidth="300" Padding="0"
                                                     KeyDown="_txtScale_KeyDown"
                                                     PreviewTextInput="TxtScale_PreviewTextInput"
                                                     DataObject.Pasting="TxtScale_Pasting">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                                                                <Setter Property="Foreground">
                                                                    <Setter.Value>
                                                                        <Binding Path="DataContext.ScaleStable"
                                                                                 RelativeSource="{RelativeSource Self}"
                                                                                 Converter="{StaticResource StableToForeground}"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ── REFERENCE VALUES DataGrid ── -->
                                <DataGrid Grid.Row="2" x:Name="dgRefValues"
                                          ItemsSource="{Binding RefRowsCollection}"
                                          Style="{StaticResource GridStyle}"
                                          RowStyle="{StaticResource RefRowStyle}"
                                          Padding="10">
                                    <DataGrid.Columns>

                                        <!-- # -->
                                        <DataGridTemplateColumn Header="#" Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="8,9,8,6" VerticalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14"
                                                            Background="#1565C0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                           
                                                            >
                                                            <TextBlock Text="{Binding No}"
                                                                   Foreground="White"
                                                                   FontWeight="Bold" FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- FIELD (Unit) -->
                                        <DataGridTemplateColumn Header="FIELD (Unit)" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="8,6,8,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding FieldName}"
                                                                   FontWeight="SemiBold" FontSize="12"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Unit}"
                                                                   FontSize="10" Foreground="#78909C"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- STD -->
                                        <DataGridTemplateColumn  Width="140">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="STD"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               ToolTipService.ShowDuration="20000">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock TextWrapping="WrapWithOverflow" Width="250">
                                                                    Most recent value.
                                                            </TextBlock>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </DataTemplate>

                                            </DataGridTemplateColumn.HeaderTemplate>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Tolerance,
                                                                         Converter={StaticResource ToleranceToBrush}}"
                                                            BorderBrush="{Binding Tolerance,
                                                                          Converter={StaticResource ToleranceToBorderBrush}}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="5"
                                                            Padding="10,6" Margin="4,4"
                                                            HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding StdDisplay}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Tolerance,
                                                                                Converter={StaticResource ToleranceToFore}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Δ -->
                                        <DataGridTemplateColumn Width="140">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="Δ"
                                                                TextWrapping="Wrap"
                                                                TextAlignment="Center"
                                                               ToolTipService.ShowDuration="20000">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock TextWrapping="WrapWithOverflow" Width="250">
                                                                            Difference between the current and most recent readings.
                                                            </TextBlock>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </DataTemplate>

                                            </DataGridTemplateColumn.HeaderTemplate>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="10,6"
                                                            Margin="0,4,4,7"
                                                            Background="{Binding Tolerance,
                                                                         Converter={StaticResource ToleranceToBrush}}"
                                                            BorderBrush="{Binding Tolerance,
                                                                          Converter={StaticResource ToleranceToBorderBrush}}"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeltaDisplay}"
                                                                   FontWeight="Bold" FontSize="13"
                                                                   Foreground="{Binding Tolerance,
                                                                                Converter={StaticResource ToleranceToFore}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- ACTUAL -->
                                        <DataGridTemplateColumn Width="140">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="ACTUAL"
                                                                TextWrapping="Wrap"
                                                                TextAlignment="Center"
                                                               ToolTipService.ShowDuration="20000">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock TextWrapping="WrapWithOverflow" Width="250">
                                                                        Current weighing value.
                                                            </TextBlock>
                                                        </TextBlock.ToolTip>
                                                        </TextBlock>
                                                </DataTemplate>

                                            </DataGridTemplateColumn.HeaderTemplate>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Tolerance,
                                                                         Converter={StaticResource ToleranceToBrush}}"
                                                            BorderBrush="{Binding Tolerance,
                                                                          Converter={StaticResource ToleranceToBorderBrush}}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="5"
                                                            Padding="10,6" Margin="4,4"
                                                            HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding ActualDisplay}"
                                                                   FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Tolerance,
                                                                                Converter={StaticResource ToleranceToFore}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════ BOTTOM BAR ═════════════════════════════ -->
        <Border Grid.Row="2" Margin="6,0,6,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="↓  Save"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding SaveCommand}"
                        Background="#1A237E" Padding="20,0" Margin="0,0,4,0"/>
                <Button Content="Cancel"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding CancelCommand}"
                        Background="#E65100" Padding="20,0" Margin="0,0,4,0"/>
                <Button Content="Confirm"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding ConfirmCommand}"
                        Background="#2E7D32" Padding="20,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════ LOADING OVERLAY ═════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}"
             d:Visibility="Collapsed"
              Background="#80000000">
            <Border Background="White" CornerRadius="8"
                    Padding="40,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="240">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Loading…" FontSize="18" FontWeight="Bold"
                               Foreground="#1565C0" HorizontalAlignment="Center"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock Text="Please wait" FontSize="12" Foreground="#78909C"
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelLoadCommand}"
                            IsEnabled="{Binding IsCancelLoadEnabled}"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Padding="20,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
