<Window
    x:Class="SSSW.UI.WPF.ShotWeightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SSSW.UI.WPF.ViewModels"
    Title="IT – Shotweight Station"
    Width="1920"
    Height="1080"
    AllowsTransparency="False"
    Background="#F0F2F5"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--  Merge style dictionary  -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <!--<RowDefinition Height="10" />-->
        </Grid.RowDefinitions>

        <!--  ═══════════════════════════════ TITLE BAR ═══════════════════════════════  -->
        <Border
            Grid.Row="0"
            Background="#0D1117"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="1"
                    Height="40"
                    Margin="5,0,10,0"
                    VerticalAlignment="Center"
                    Source="/SSSW;component/Resources/framas_mini_white.png" />


                <!--  Binding WindowTitle từ ViewModel  -->
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="White"
                    Text="{Binding WindowTitle}" />

                <StackPanel Grid.Column="3" />

                <!--  Binding UserName từ ViewModel  -->
                <!--
                <TextBlock
                    Grid.Column="4"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#90A4AE"
                    Text="{Binding UserName}" />-->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <!--  status dot  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{Binding RfidStatus, Converter={StaticResource DriverStatusToColor}}" />

                    <TextBlock
                        Grid.Column="1"
                        Padding="10"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource LabelStyle}"
                        Text="RFID - Employee ID:" />

                    <TextBlock
                        Name="_tbEmployee"
                        Padding="10"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="15"
                        Foreground="White"
                        IsEnabled="{Binding ReadonlyRfid}"
                        MouseLeftButtonDown="_tbEmployee_MouseLeftButtonDown"
                        Text="{Binding UserName}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="5"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ReloadCommand}"
                        Content="&#xE72C;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Reload" />
                    <Button
                        Command="{Binding HistoryViewCommand}"
                        Content="&#xE81C;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="History" />
                    <Button
                        Command="{Binding HydraCommand}"
                        Content="&#xE895;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Hydra" />
                    <Button
                        Command="{Binding SettingsCommand}"
                        Content="&#xE713;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Settings" />
                    <Button
                        Command="{Binding UpdateCommand}"
                        Content="&#xE777;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Update" />
                    <Button
                        Click="btnMinimize_Click"
                        Content="&#xE921;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Minimize" />
                    <Button
                        Click="btnMaximize_Click"
                        Content="&#xE922;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Maximize" />
                    <Button
                        Background="#C62828"
                        Click="btnClose_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource TitleIconBtn}"
                        ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ═══════════════════════════════ MAIN CONTENT ════════════════════════════  -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!--  ────────────────── LEFT PANEL – STEP INFORMATION ──────────────────  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="#0D1117"
                            CornerRadius="4,4,0,0">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="STEP INFORMATION" />
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <!--  Form content  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Name  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Code  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Machine + Qty  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Partition  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Runner  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Size  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  FG Desc  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  FG Code  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Lookup  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  Barcode  -->

                                    <!--  ✅ Remark chiếm phần còn lại  -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Name  -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Name" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        MaxLines="3"
                                        MinLines="2"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding StepName}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  Code  -->
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Code" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding StepCode}" />
                                </StackPanel>

                                <!--  Machine + Qty  -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Machine" />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Machine}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Quantity" />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Qty}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Partition  -->
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Partitioning (prs)" />
                                        <TextBox
                                            KeyDown="tbActualPairs_KeyDown"
                                            Style="{StaticResource EditableFieldStyle}"
                                            Text="{Binding ActualPairs}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Adjust no. of prs" />
                                        <CheckBox IsChecked="{Binding AllowPartitionAdj}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Runner  -->
                                <Grid Grid.Row="4" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Runner" />
                                        <ComboBox
                                            FontSize="15"
                                            SelectedValue="{Binding RunnerText}"
                                            SelectedValuePath="Content">
                                            <ComboBoxItem Content="YES" />
                                            <ComboBoxItem Content="NO" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Usage %" />
                                        <TextBox
                                            KeyDown="tbUsagePct_KeyDown"
                                            Style="{StaticResource EditableFieldStyle}"
                                            Text="{Binding UsagePct}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Size  -->
                                <Grid Grid.Row="5" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Size" />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Size}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Step No." />
                                        <TextBox Style="{StaticResource FieldStyle}" Text="{Binding StepIndex}" />
                                    </StackPanel>
                                </Grid>

                                <!--  FG  -->
                                <StackPanel Grid.Row="6">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="FG Description" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        MinLines="2"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding FgName}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="7">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="FG Item Code" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding FgItemCode}" />
                                </StackPanel>

                                <!--  Lookup  -->
                                <StackPanel Grid.Row="8">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Select Step" />
                                    <!--  DevExpress LookUpEdit: ItemsSource từ ViewModel, event bridge ở code-behind  -->
                                    <dxg:LookUpEdit
                                        x:Name="cbStepName"
                                        Margin="0,0,0,8"
                                        AutoComplete="True"
                                        AutoPopulateColumns="False"
                                        DisplayMember="StepItemName"
                                        EditValueChanged="cbStepName_EditValueChangedAsync"
                                        FontSize="15"
                                        ItemsSource="{Binding StepCodeMaster}"
                                        PopupHeight="500"
                                        PopupWidth="1000"
                                        TextWrapping="Wrap"
                                        ValueMember="StepItemCode">
                                        <dxg:LookUpEdit.StyleSettings>
                                            <dxg:LookUpEditStyleSettings AllowColumnFiltering="True" />
                                        </dxg:LookUpEdit.StyleSettings>
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <dxg:GridControl Name="PART_GridControl" IsFilterEnabled="True">
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn
                                                            ColumnFilterMode="DisplayText"
                                                            FieldName="Machine"
                                                            FilterPopupMode="Excel"
                                                            Header="Machine" />
                                                        <dxg:GridColumn FieldName="StepItemCode" Header="Step Code" />
                                                        <dxg:GridColumn FieldName="StepItemName" Header="Step Name" />
                                                        <dxg:GridColumn FieldName="Size" Header="Size" />
                                                        <dxg:GridColumn FieldName="HydraOrderNo" Header="Hydra Order No" />
                                                        <dxg:GridColumn FieldName="FT601Id" Header="FT601 Id" />
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <dxg:TableView
                                                            AutoWidth="True"
                                                            ShowAutoFilterRow="True"
                                                            ShowFilterPanelMode="ShowAlways" />
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </StackPanel>

                                <!--  Barcode  -->
                                <StackPanel Grid.Row="9">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Barcode / QR Scan" />
                                    <TextBox
                                        KeyDown="_txtBarcode_KeyDown"
                                        Style="{StaticResource FieldStyle}"
                                        Text="{Binding BarcodeScannedValue}"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>

                                <!--  ✅ ✅ ✅ REMARK (FULL HEIGHT)  -->
                                <Grid Grid.Row="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Remark" />

                                    <TextBox
                                        Grid.Row="1"
                                        AcceptsReturn="True"
                                        Style="{StaticResource EditableFieldStyle}"
                                        Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Grid>

                            </Grid>
                        </ScrollViewer>

                    </Grid>
                </Border>
            </Grid>
            <!--  ────────────────── RIGHT AREA ──────────────────  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="428" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  TOTAL STEPS  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="#0D1117"
                            CornerRadius="4,4,0,0">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="TOTAL STEPS" />
                        </Border>

                        <!--  ItemsSource binding từ ViewModel  -->
                        <DataGrid
                            x:Name="dgTotalSteps"
                            Grid.Row="1"
                            Padding="10"
                            ItemsSource="{Binding StepsCollection}"
                            SelectionChanged="dgTotalSteps_SelectionChanged"
                            Style="{StaticResource GridStyle}">
                            <DataGrid.Columns>

                                <!--  Action buttons – Command binding lên Window DataContext  -->
                                <DataGridTemplateColumn Width="125" IsReadOnly="False">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="Actions"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Command="{Binding DataContext.GridScaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Scale"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Command="{Binding DataContext.GridResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Reset"
                                                    Style="{StaticResource WarningButton}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Command="{Binding DataContext.GridDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    Tag="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  STATUS  -->
                                <DataGridTemplateColumn Width="65">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="STATUS"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="0,0,0,14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusDotColor}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{Binding StatusText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="75"
                                    Binding="{Binding C004}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="MACHINE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="150">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="MAIN / MAIN CODE"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding C027}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#78909C"
                                                    Text="{Binding C026}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding C015}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="Step No."
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="300">
                                    <!--  HEADER TEMPLATE  -->
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="STEP / STEP CODE"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <!--  CELL TEMPLATE  -->
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding C003}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#78909C"
                                                    Text="{Binding C002}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C008}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="SIZE"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C024, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="TOTAL INJECTION (g)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        Total weight after ejection. Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C023, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="TOTAL PART (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        Includes the par of the current step and previous steps. Reading from the scale.
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding C021, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="PART (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        Part weight of the current step. Calculation = (TOTAL PART WEIGHT − TOTAL PART WEIGHT of the previous step) / pairs per shot
                                                    </TextBlock>
                                                </TextBlock.ToolTip>

                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C022, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="RUNNER / EXCESS MAT. (g/prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        Runner weight of the current step. Calculation = (TOTAL WEIGHT INJECTION - TOTAL PART WEIGHT) / pairs per shot
                                                    </TextBlock>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C028, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="Actual Partitioning (prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <!--<TextBlock.ToolTip>
                                                    <TextBlock Width="250" TextWrapping="Wrap">
                                                        Runner weight of the current step. Calculation = (TOTAL WEIGHT INJECTION - TOTAL PART WEIGHT) / pairs per shot
                                                    </TextBlock>
                                                </TextBlock.ToolTip>-->
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding C017, StringFormat=F2}"
                                    ElementStyle="{StaticResource CenterCell}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="PPIC Partitioning (prs)"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWithOverflow"
                                                ToolTipService.ShowDuration="20000">
                                                <!--<TextBlock.ToolTip>
                    <TextBlock Width="250" TextWrapping="Wrap">
                        Runner weight of the current step. Calculation = (TOTAL WEIGHT INJECTION - TOTAL PART WEIGHT) / pairs per shot
                    </TextBlock>
