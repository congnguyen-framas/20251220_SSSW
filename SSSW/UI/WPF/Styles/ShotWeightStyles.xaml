<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SSSW.UI.WPF.Converters"
    xmlns:mdl="clr-namespace:SSSW.UI.WPF.Models">

    <!--
        ════════════════════════════════════════════════════════════════
        CONVERTERS
        ════════════════════════════════════════════════════════════════
    -->
    <conv:ToleranceToBrushConverter x:Key="ToleranceToBrush" />
    <conv:ToleranceToBorderBrushConverter x:Key="ToleranceToBorderBrush" />
    <conv:ToleranceToForeConverter x:Key="ToleranceToFore" />
    <conv:ValueUnitConverter x:Key="ValueUnit" />
    <!--  WPF built-in: tránh XDG-000 "incompatible type" trong XAML designer  -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!--  ScanAndScale.Core – trạng thái kết nối thiết bị  -->
    <conv:DriverStatusToColorConverter x:Key="DriverStatusToColor" />
    <conv:StableToForegroundConverter x:Key="StableToForeground" />
    <conv:TareToBackgroundConverter x:Key="TareToBackground" />
    <BooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

    <!--
        ════════════════════════════════════════════════════════════════
        TEXT – LABEL / FIELD
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#37474F" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="FieldStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="#FAFAFA" />
        <Setter Property="BorderBrush" Value="#CFD8DC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="IsReadOnly" Value="{Binding ReadOnly}" />
    </Style>

    <Style
        x:Key="EditableFieldStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource FieldStyle}">
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Background" Value="White" />
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        CARD BORDER
        ════════════════════════════════════════════════════════════════
    -->
    <!--  Icon "i" ở tiêu đề card: hover để xem mô tả card (ToolTip khai báo tại nơi dùng)  -->
    <Style x:Key="InfoIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Background="Transparent"
                        BorderBrush="#B0BEC5"
                        BorderThickness="1.5"
                        CornerRadius="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="i" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#CFD8DC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        BOTTOM BUTTON
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="BottomBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        TITLE BAR ICON BUTTON
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="TitleIconBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3A4A7A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        DATAGRID – GLOBAL
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="GridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#ECEFF1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F8FAFB" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F5F7FA" />
        <Setter Property="Foreground" Value="#37474F" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="#DDE3EA" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#1976D2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        TOTAL STEPS – dòng step + Row Details BOM Level 2
        Cột của Row Details bám theo ActualWidth của cột lưới chính (cùng đường dọc):
        Component→Actions(0), Status→STATUS(1), Step→MACHINE(2), Qty→MAIN / MAIN CODE(3), Unit→Step No.(4);
        Weighed / g per piece / Deduct chia đều 3 phần trong bề rộng cột STEP / STEP CODE(5).
        Chỉ số = thứ tự cột trong dgTotalSteps.
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="StepRowStyle" TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="#90A4AE" />
                <Setter Property="Background" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

<DataTemplate x:Key="Level2DetailsTemplate">
    <StackPanel Margin="0,0,0,6" HorizontalAlignment="Left" Background="White">
        <StackPanel Height="28" Background="#EAF1F8" Orientation="Horizontal">
            <Border Width="{Binding Columns[0].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                <TextBlock Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Component" />
            </Border>
            <Border Width="{Binding Columns[1].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Status" TextAlignment="Center" TextWrapping="Wrap" /></Border>
            <Border Width="{Binding Columns[2].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Step" TextAlignment="Center" TextWrapping="Wrap" /></Border>
            <Border Width="{Binding Columns[3].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Qty" TextAlignment="Center" TextWrapping="Wrap" /></Border>
            <Border Width="{Binding Columns[4].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Unit" TextAlignment="Center" TextWrapping="Wrap" /></Border>
            <Grid Width="{Binding Columns[5].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Weighed" TextAlignment="Center" TextWrapping="Wrap" /></Border>
                <Border Grid.Column="1"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Weight / piece" TextAlignment="Center" TextWrapping="Wrap" /></Border>
                <Border Grid.Column="2"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#37474F" Text="Deduct" TextAlignment="Center" TextWrapping="Wrap" /></Border>
            </Grid>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Level2Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border MinHeight="30" BorderBrush="#ECEFF1" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{Binding Columns[0].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                            <TextBlock Margin="6,3,4,3" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Text="{Binding Component}" TextWrapping="Wrap" ToolTip="{Binding ComponentCode}" />
                        </Border>
                            <Border Width="{Binding Columns[1].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,1" CornerRadius="9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFEBEE" />
                                        <Setter Property="BorderBrush" Value="#EF5350" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeighed}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                        <Setter Property="BorderBrush" Value="#66BB6A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWeighed}" Value="True">
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            </Border>
<Border Width="{Binding Columns[2].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Step}" /></Border>
<Border Width="{Binding Columns[3].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Qty, StringFormat=0.##}" /></Border>
<Border Width="{Binding Columns[4].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Unit}" /></Border>
                        <Grid Width="{Binding Columns[5].ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding WeighedText}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding PerPieceText}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding DeductText}" />
                        </Grid>
                    </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            <TextBlock Margin="6,6,0,2" FontSize="12" Foreground="#78909C" Text="No components">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level2Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border
                Margin="6,6,6,2"
                Padding="8,4"
                BorderBrush="#90A4AE"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding Level2Formula, Converter={StaticResource NullToCollapsed}}">
                <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding Level2Formula}" TextAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#37474F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level2HasMissing}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!--  ── Reference row style — rows luôn trắng, màu tolerance hiện trên từng ô ──  -->
    <Style x:Key="RefRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="White" />
        <Setter Property="MinHeight" Value="60" />
    </Style>


    <!--
        ════════════════════════════════════════════════════════════════
        CELL TEXT STYLES
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="CenterCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>

    <Style x:Key="RightCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,13" />
    </Style>

    <Style x:Key="LeftCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,13" />
    </Style>

    <Style x:Key="RightCellBold" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="cellWrap" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        GRID BUTTON
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="BaseBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <!--<Setter Property="Height"          Value="25"/>
        <Setter Property="MinWidth"        Value="140"/>-->
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="PrimaryButton"
        TargetType="Button"
        BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background" Value="#1976D2" />
        <Setter Property="Foreground" Value="White" />

    </Style>

    <Style
        x:Key="WarningButton"
        TargetType="Button"
        BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background" Value="#F9A825" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style
        x:Key="DangerButton"
        TargetType="Button"
        BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background" Value="#D32F2F" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        TOOLTIP
        ════════════════════════════════════════════════════════════════
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#263238" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">

                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                ShadowDepth="2"
                                Opacity="0.3" />
                        </Border.Effect>

                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        MAIN SHELL – NAV TAB (Step Component / Finished Goods)
        RadioButton so exactly one is checked; template-only styling.
        ════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="NavTabBtn" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#B0BEC5" />
        <Setter Property="BorderBrush" Value="#37474F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1B2430" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2E7D32" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C62828" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
