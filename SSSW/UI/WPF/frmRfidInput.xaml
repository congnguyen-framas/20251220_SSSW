<Window
    x:Class="SSSW.frmRfidInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SSSW"
    Title="frmRfidInput"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid Margin="5">
        <!--  chia 2 cột  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  ===== LEFT COLUMN =====  -->
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Label  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="RFID / Employee ID" />
            </Grid>

            <!--  TextBox  -->
            <TextBox Name="_txtRfid"
                Grid.Row="1"
                Height="36"
                HorizontalAlignment="Stretch"
                IsReadOnly="{Binding ReadOnlyRfid}"
                KeyDown="_txtRfid_KeyDown"
                Text="{Binding RfidCardCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  ===== RIGHT COLUMN =====  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Label  -->
            <TextBlock
                Grid.Row="0"
                Text="Employee Name" />

            <!--  TextBox  -->
            <TextBox
                Name="tbRFIDName"
                Grid.Row="1"
                Height="36"
                HorizontalAlignment="Stretch"
                Text="{Binding RfidName, Mode=OneWay}" />
        </Grid>

    </Grid>
</Window>
