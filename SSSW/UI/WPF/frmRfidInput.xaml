<Window
    x:Class="SSSW.frmRfidInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SSSW"
    Title="Manual Employee ID Entry"
    Width="520"
    Height="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/WPF/Styles/ShotWeightStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  fields  -->
            <RowDefinition Height="Auto" />
            <!--  hint  -->
            <RowDefinition Height="*" />
            <!--  spacer  -->
            <RowDefinition Height="Auto" />
            <!--  buttons  -->
        </Grid.RowDefinitions>

        <!--  ===== INPUT FIELDS =====  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!--  ===== LEFT COLUMN – RFID / Employee ID =====  -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource LabelStyle}"
                    Text="RFID / Employee ID" />

                <TextBox
                    Name="_txtRfid"
                    Grid.Row="1"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    KeyDown="_txtRfid_KeyDown"
                    Style="{StaticResource EditableFieldStyle}"
                    Text="{Binding RfidCardCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  ===== RIGHT COLUMN – Employee Name =====  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource LabelStyle}"
                    Text="Employee Name" />

                <TextBox
                    Name="tbRFIDName"
                    Grid.Row="1"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    KeyDown="tbRFIDName_KeyDown"
                    Style="{StaticResource EditableFieldStyle}"
                    Text="{Binding RfidName, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!--  Hướng dẫn: Enter ở ô ID để tra cứu; nếu chưa có thì gõ tên rồi Enter ở ô Name để đăng ký mới  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="#78909C"
            Text="Press Enter in the ID field to look up. If the ID is not found, type the name and press Enter in the Name field to register a new operator."
            TextWrapping="Wrap" />

        <!--  ===== BOTTOM BUTTON BAR =====  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Padding="20,0"
                Background="#E65100"
                Click="btnCancel_Click"
                Style="{StaticResource BottomBtn}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Text="❌" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
            <Button
                Margin="8,0,0,0"
                Padding="20,0"
                Background="#2E7D32"
                Click="btnOk_Click"
                Style="{StaticResource BottomBtn}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Text="✔" />
                    <TextBlock Text="OK" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
