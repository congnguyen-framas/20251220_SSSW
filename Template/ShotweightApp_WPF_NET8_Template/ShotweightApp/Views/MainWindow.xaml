<Window x:Class="ShotweightApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shotweight Station"
        Height="600"
        Width="1000"
        Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TOTAL STEPS"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0 0 0 10"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Steps}"
                  SelectedItem="{Binding SelectedStep}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0 10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="100"/>
                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*"/>
                <DataGridTextColumn Header="Std" Binding="{Binding Std}" Width="80"/>
                <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="80"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Done">
                            <Setter Property="Background" Value="#D1FAE5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                            <Setter Property="Background" Value="#F3F4F6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Save"
                Command="{Binding SaveCommand}"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>
